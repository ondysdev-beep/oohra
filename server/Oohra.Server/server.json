// Nastavení serveru Oohra. Komentáře jsou povolené.
{
  "port": 9050,
  "seed": 1,
  // 0 = velikost ostrova podle settings.json (384).
  "worldSize": 0,
  // Kódy pozvánek pro testery. Kdo nemá kód, nepřihlásí se.
  "inviteCodes": [ "OOHRA-TEST" ],
  "maxPlayers": 20,
  // Zrychlení herního času jen pro zkoušení (1 = normální čas, den 90 minut).
  "timeSpeed": 1,
  // Jen pro zkoušení: v kolik hodin svět začíná (21 = hned noc) a materiál na oheň do začátku.
  "startHour": 7,
  "startSticks": 0,
  "startStones": 0,
  // Jen pro zkoušení a roboty: nová postava dostane malý batoh. Ve hře false (nováček má jen dvě ruce).
  "startBag": false,
  // Jen pro zkoušení: vynucené počasí (jasno, mlha, dest, bourka). Prázdné = počasí jde samo (ze seedu a času).
  // Za běhu jde změnit příkazem pocasi v okně serveru.
  "forceWeather": "",
  // Jak často vypsat výkon serveru (sekundy, jen když někdo hraje). 0 = nevypisovat.
  "statsEverySeconds": 10,
  // Zvířata na ostrově a do jaké vzdálenosti (metry) hráč dostává jejich polohy.
  "animals": true,
  "animalViewDistance": 40,
  // Po odpojení zůstane postava ještě tolik sekund ve světě (aby se odpojením nedalo utéct před vlkem).
  "logoutLingerSeconds": 30,
  // Cizí kmeny (NPC) ve dvou táborech: mluví svým jazykem, odpovídají na slova a gesta, darují jídlo.
  "strangers": true,
  // Vosí hnízda ve stromech štípou, kdo k nim přijde (false = vypnout, třeba pro zkoušení).
  "wasps": true,
  // Tlačítko Nahlásit: nahlášení se zapisují sem (jeden záznam na řádek), nejvýš jedno za reportCooldownSeconds.
  "reportsFile": "reports.jsonl",
  "reportCooldownSeconds": 30,
  // Uložený svět: každých worldSaveSeconds a při vypnutí serveru, po startu se načte.
  // Zálohy jednou za backupEveryMinutes do složky zalohy (nechá se backupsKept posledních).
  // Nový svět = soubor world.json přesunout jinam (ne mazat, ať zůstane záloha).
  "worldFile": "world.json",
  "worldSaveSeconds": 120,
  "backupEveryMinutes": 60,
  "backupsKept": 48,
  // Statistiky hraní pro ladění (kolik kdo hraje, na co umírá, co dělá). Testeři o nich vědí.
  // Ukládají se každých statsSaveSeconds a při vypnutí serveru.
  "statsFile": "stats.json",
  "statsSaveSeconds": 300,
  // Vyloučení hráči (přezdívky). Po změně restartuj server.
  "bannedNicknames": []
}
