<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Knihovna se překládá dvakrát:
    net10.0        pro server, testy a TestClient,
    netstandard2.1 kvůli kontrole, že Core jde přeložit i pro starší .NET (do Unity se ale nedává, viz níže).
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      Nezapisovat do DLL ani do ladicích informací číslo git commitu (verze a SourceLink),
      jinak by se DLL v Unity měnila s každým commitem, i když se kód nezmění.
    -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <EnableSourceLink>false</EnableSourceLink>
  </PropertyGroup>

  <!-- Datové soubory hry se zabalí do knihovny (načítá je GameData). -->
  <ItemGroup>
    <EmbeddedResource Include="Data\*.json" />
  </ItemGroup>

  <!-- JSON čte Newtonsoft.Json. -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Oohra.Shared\Oohra.Shared.csproj" />
  </ItemGroup>

  <!--
    Do Unity se Core NEKOPÍRUJE: jsou v něm skrytá data (složení rostlin) a klient je nesmí mít.
    Unity dostává jen Oohra.Shared a Oohra.Protocol. Verze netstandard2.1 zůstává pro případné nástroje.
  -->

</Project>
