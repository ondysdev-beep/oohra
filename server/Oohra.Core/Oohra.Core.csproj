<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Knihovna se překládá dvakrát:
    net10.0        pro server, testy a TestClient,
    netstandard2.1 pro Unity (Unity umí jen .NET Standard 2.1 a C# 9, proto nový C# překládáme my).
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      Nezapisovat do DLL ani do ladicích informací číslo git commitu (verze a SourceLink),
      jinak by se DLL v Unity měnila s každým commitem, i když se kód nezmění.
    -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <EnableSourceLink>false</EnableSourceLink>
  </PropertyGroup>

  <!-- Datové soubory hry se zabalí do knihovny (načítá je GameData). -->
  <ItemGroup>
    <EmbeddedResource Include="Data\*.json" />
  </ItemGroup>

  <!-- JSON čte Newtonsoft.Json. Unity ho má jako oficiální balíček (com.unity.nuget.newtonsoft-json). -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Oohra.Shared\Oohra.Shared.csproj" />
  </ItemGroup>

  <!-- Verze pro Unity se po sestavení zkopíruje do Unity projektu. Newtonsoft si Unity bere ze svého balíčku. -->
  <Target Name="CopyToUnity" AfterTargets="Build" Condition="'$(TargetFramework)' == 'netstandard2.1' And Exists('$(MSBuildProjectDirectory)\..\..\unity\Assets')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)\..\..\unity\Assets\Plugins\Oohra" SkipUnchangedFiles="true" />
  </Target>

</Project>
