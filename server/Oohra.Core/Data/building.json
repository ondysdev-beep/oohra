// Stavby z režimu stavby (zeď z klacků, zeď s otvorem, dveře) a úkryt.
// Vychází z buildWall a sheltered v prototypu (part5.js, part4.js), ale stavby nejsou vázané na dlaždice:
// mají přesnou polohu a úhel. Vzdálenosti v metrech (1 dlaždice = 1 m).
{
  // Jak daleko od sebe smí postava stavět (střed stavby od středu postavy). Dál, ať je na stavbu vidět.
  "placeReach": 10,
  // Stavět jde jen na rovnějším místě: mezi nejvyšším a nejnižším bodem pod stavbou (konce zdi, rohy podlahy, místo
  // ohně a dekorace) smí být nejvýš maxRise metrů.
  "maxRise": 0.8,
  "wall": {
    // Příčka z klacků: plná délka (hrana políčka stavební mřížky 2 × 2 m, BuildGrid) a tloušťka stěny. Zeď s otvorem
    // má vždy plnou délku. sticksCost je za plnou délku, kratší zeď stojí úměrně méně (zaokrouhleno nahoru).
    "length": 2.0,
    "thickness": 0.1,
    "minLength": 0.25,
    "sticksCost": 4,
    // Krátká zeď (nejvýš shortMaxLength) stojí méně.
    "shortMaxLength": 0.5,
    "shortSticksCost": 1,
    // Rozebráním se vrátí polovina klacků (zaokrouhleno dolů).
    // Jak blízko musí postava být, aby stavbu rozebrala.
    "removeReach": 1.6
  },
  "doorFrame": {
    // Zeď s otvorem: otvor uprostřed, po krajích zeď (zbytek délky). Otvorem se dá projít.
    "openingWidth": 0.9,
    "sticksCost": 3,
    "sticksBack": 1
  },
  "door": {
    // Dveře se vsadí do nejbližšího volného otvoru, když je jeho střed do snapDistance od místa stavby.
    "snapDistance": 0.7,
    "sticksCost": 2,
    "sticksBack": 1
  },
  "trap": {
    // Past z klacků (staví se v režimu stavby jako oheň). Chytí kořist, která jde kolem (animals.json, traps).
    "sticksCost": 3,
    // Zvednutím pasti se vrátí část klacků.
    "sticksBack": 2,
    "footprintRadius": 0.35
  },
  // Sloupek, podlaha a střecha (návrh 0.8, kap. 6, první vlna). Sloupek podpírá střechu, blokuje jako kruh.
  "post": { "sticksCost": 1, "sticksBack": 0, "radius": 0.1 },
  // Podlaha: čtverec size × size na zemi (nepřekáží v chůzi). Později na ní stojí druhé podlaží.
  "floor": { "sticksCost": 3, "sticksBack": 1, "size": 2 },
  // Střecha: čtverec size × size ve výšce zdí. Drží, když se opírá aspoň o minSupports podpor: zeď (aspoň
  // minWallSupport metrů pod ní nebo pod okrajem, supportTolerance metrů za okrajem se počítá), sloupek pod ní,
  // nebo sousední střecha do neighbourDistance, která sama drží. Bez podpory zapraská a za warnSeconds spadne:
  // kdo je pod ní, dostane damage zdraví. Před deštěm chrání střecha, ne zdi.
  "roof": {
    "sticksCost": 3, "sticksBack": 1, "size": 2,
    "supportTolerance": 0.3, "minWallSupport": 0.4, "minSupports": 2, "neighbourDistance": 2.15,
    "warnSeconds": 5, "damage": 25, "checkSeconds": 0.5
  },
  // Žebřík k podlaze patra: staví se v přízemí do floorMargin metrů od podlahy patra. Lézt jde do reach metrů.
  "ladder": { "sticksCost": 3, "sticksBack": 1, "reach": 1.6, "floorMargin": 0.7 },
  // Patro: seskočit dolů ubere jumpDamage zdraví, pád se zřícenou podlahou fallDamage.
  "storey": { "jumpDamage": 6, "fallDamage": 18 },
  // Materiály střechy (návrh 0.8, kap. 6): cena (klacky a item × count) a za kolik dní začne zatékat (pak
  // před deštěm nechrání, dokud se neopraví). Oprava stojí repairShare materiálu (zaokrouhleno nahoru).
  // Došky z trávy a hlína přijdou s novými surovinami.
  "roofMaterials": [
    { "material": "Branches", "sticks": 3, "item": "Stick", "count": 0, "days": 4 },
    { "material": "Bark", "sticks": 2, "item": "Bast", "count": 3, "days": 10 },
    { "material": "Hide", "sticks": 2, "item": "TannedHide", "count": 2, "days": 20 },
    { "material": "Shingles", "sticks": 2, "item": "Wood", "count": 4, "days": 40 }
  ],
  "repairShare": 0.5,
  // Oheň ve stavbě: hořící ohniště do igniteRange metrů od dřevěné stavby (nebo pod deskou) ji zapálí se šancí
  // igniteChancePerMinute za herní minutu (v dešti × rainFactor). Hořící stavba zapaluje sousední do spreadRange,
  // za burnMinutes shoří. Kdo je do heatRange, ztrácí heatDamagePerMinute zdraví. Ohniště uvnitř kruhu z kamenů
  // (ringDecoration) nic nezapálí.
  "buildingFire": {
    "igniteRange": 1.4, "igniteChancePerMinute": 0.008, "rainFactor": 0.3,
    "spreadRange": 0.6, "spreadChancePerMinute": 0.03, "burnMinutes": 40,
    "heatRange": 1.0, "heatDamagePerMinute": 0.8, "warnEveryMinutes": 5, "ringDecoration": "stone_circle"
  },
  // Nosnost (statika, druhý krok): váha staveb jde shora dolů (střecha patra na zdi patra, ty na podlahu patra,
  // ta na sloupky a zdi přízemí). Sloupek unese postCapacity, zeď wallCapacityPerMeter na metr své délky (k tomu,
  // co sama váží). Co je přetížené, zapraská a spadne. Zeď váží za metr, člověk v patře person.
  "load": {
    "weights": {
      "StickWall": 1, "DoorFrame": 1, "Door": 0.5, "Post": 0.3, "Floor": 1.5, "Ladder": 0.3,
      "Stockpile": 1, "Decoration": 1, "Barricade": 1, "Trap": 0.3, "Campfire": 0, "Roof": 1
    },
    "roofWeights": { "Branches": 1, "Bark": 1.5, "Hide": 2, "Shingles": 3 },
    "person": 1,
    "postCapacity": 4,
    "wallCapacityPerMeter": 6
  },
  "barricade": {
    // Zátaras u vchodu do jeskyně (návrh 0.8, kap. 4): staví se jen do entranceReach metrů od vchodu, jeden na vchod.
    // Dovnitř pak projde jen majitel a jeho kmen, ven každý.
    "sticksCost": 6,
    "sticksBack": 3,
    "entranceReach": 2.5
  },
  "stockpile": {
    // Zásoby kmene: koš z klacků. Ukládat a brát smí majitel a jeho kmen (návrh 14.1).
    "sticksCost": 4,
    "sticksBack": 2,
    // Kolik hromádek se do koše vejde.
    "capacity": 20,
    "footprintRadius": 0.35,
    // Jak blízko musí postava být, aby do koše sáhla.
    "reach": 1.6
  },
  "shelter": {
    // Úkryt: z postavy se vyšle tolik paprsků do všech stran. Když každý do maxDistance narazí na zeď
    // (nebo zavřené dveře), postava je v úkrytu (prostor uzavřený zdmi, nejvýš asi 6 × 6 m).
    "rays": 24,
    "maxDistance": 3.5,
    // O kolik se v úkrytu zvedne cíl tepla těla (oheň dává 28).
    "warmthBonus": 14
  },
  // Místo narození je chráněné před cizí stavbou (návrh 4.1), aby nikdo nezazdil, kde se jiní rodí.
  // Prvních tolik herních hodin po narození tam do vzdálenosti radius (m) smí stavět jen ten, kdo se narodil, a jeho kmen.
  "birthGuard": {
    "hours": 24,
    "radius": 5
  }
}
