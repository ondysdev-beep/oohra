// Stavby z režimu stavby (zeď z klacků, zeď s otvorem, dveře) a úkryt.
// Vychází z buildWall a sheltered v prototypu (part5.js, part4.js), ale stavby nejsou vázané na dlaždice:
// mají přesnou polohu a úhel. Vzdálenosti v metrech (1 dlaždice = 1 m).
{
  // Jak daleko od sebe smí postava stavět (střed stavby od středu postavy). Dál, ať je na stavbu vidět.
  "placeReach": 3.5,
  "wall": {
    // Příčka z klacků: plná délka a tloušťka stěny. Zeď s otvorem má vždy plnou délku.
    "length": 1.0,
    "thickness": 0.1,
    // Zeď může být i kratší (poloviční zeď, nebo dorovnání mezery, aby zdi do sebe zapadly).
    "minLength": 0.25,
    "sticksCost": 2,
    // Krátká zeď (nejvýš shortMaxLength) stojí méně.
    "shortMaxLength": 0.5,
    "shortSticksCost": 1,
    // Rozebráním se vrátí polovina klacků (zaokrouhleno dolů).
    // Jak blízko musí postava být, aby stavbu rozebrala.
    "removeReach": 1.6
  },
  "doorFrame": {
    // Zeď s otvorem: otvor uprostřed, po krajích sloupky (zbytek délky zdi). Otvorem se dá projít.
    "openingWidth": 0.8,
    "sticksCost": 2,
    "sticksBack": 1
  },
  "door": {
    // Dveře se vsadí do nejbližšího volného otvoru, když je jeho střed do snapDistance od místa stavby.
    "snapDistance": 0.7,
    "sticksCost": 2,
    "sticksBack": 1
  },
  "trap": {
    // Past z klacků (staví se v režimu stavby jako oheň). Chytí kořist, která jde kolem (animals.json, traps).
    "sticksCost": 3,
    // Zvednutím pasti se vrátí část klacků.
    "sticksBack": 2,
    "footprintRadius": 0.35
  },
  "stockpile": {
    // Zásoby kmene: koš z klacků. Ukládat a brát smí majitel a jeho kmen (návrh 14.1).
    "sticksCost": 4,
    "sticksBack": 2,
    // Kolik hromádek se do koše vejde.
    "capacity": 20,
    "footprintRadius": 0.35,
    // Jak blízko musí postava být, aby do koše sáhla.
    "reach": 1.6
  },
  "shelter": {
    // Úkryt: z postavy se vyšle tolik paprsků do všech stran. Když každý do maxDistance narazí na zeď
    // (nebo zavřené dveře), postava je v úkrytu (prostor uzavřený zdmi, nejvýš asi 6 × 6 m).
    "rays": 24,
    "maxDistance": 3.5,
    // O kolik se v úkrytu zvedne cíl tepla těla (oheň dává 28).
    "warmthBonus": 14
  },
  // Místo narození je chráněné před cizí stavbou (návrh 4.1), aby nikdo nezazdil, kde se jiní rodí.
  // Prvních tolik herních hodin po narození tam do vzdálenosti radius (m) smí stavět jen ten, kdo se narodil, a jeho kmen.
  "birthGuard": {
    "hours": 24,
    "radius": 5
  }
}
