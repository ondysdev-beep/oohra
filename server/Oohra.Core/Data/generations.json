// Pradávní a Noví (návrh 8.4). Přepsáno z funkce G() v prototype/src/part2.js.
// Pradávný (generace 0) má pevné hodnoty. Nový generace g má: 1 + perGeneration × g.
{
  // Od této generace se hodnoty už nemění (strop).
  "cap": 6,
  "ancient": {
    "toxinMultiplier": 0.6,
    "healMultiplier": 1.05,
    "energyDrainMultiplier": 1,
    "coldBonus": 7,
    "speedMultiplier": 0.95,
    "learnMultiplier": 1,
    "woundMultiplier": 0.78,
    // Železný žaludek: zkažené jídlo je u Pradávných skoro neškodné.
    "spoiledMultiplier": 0.45
  },
  "newPerGeneration": {
    "toxinMultiplier": 0.04,
    "healMultiplier": 0.04,
    "energyDrainMultiplier": -0.03,
    // Teplota těla Nových klesá o 1,3 za generaci, nejvýš do coldGenerationCap generací.
    "coldBonus": -1.3,
    "speedMultiplier": 0.02,
    // Noví se učí rychleji (nácvik dovedností ×(1 + 0,08·g)).
    "learnMultiplier": 0.08,
    // Noví jsou křehčí: zranění od zvířat ×(1 + 0,03·g).
    "woundMultiplier": 0.03,
    "spoiledMultiplier": 0
  },
  "coldGenerationCap": 4,
  // Noví jsou rychlejší, ale nejvýš o 10 %.
  "speedMultiplierMax": 1.1,
  // Generace světa (návrh 8.2): roste o jednu každých daysPerGeneration skutečných dní od vzniku světa
  // (182,5 dne = půl roku). Prvních půl roku jsou to Pradávní (0), pak Noví (1), pak třetí generace (2)…, strop je cap.
  // Kdo do světa přijde poprvé, narodí se jako aktuální generace. Po smrti jako aktuální generace, ale aspoň Nový
  // (status Pradávného se smrtí ztrácí navždy, návrh 8.6).
  "daysPerGeneration": 182.5
}
