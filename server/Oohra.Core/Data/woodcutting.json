// Kácení a dřevo (návrh 0.8, kap. 2). Počet seknutí a dřeva podle druhu stromu je v trees.json.
{
  // Kamenná sekera: z čeho je a kolik seknutí vydrží, než se rozpadne.
  "axe": { "sticks": 1, "stones": 2, "uses": 60 },
  // Jak blízko musí postava být ke stromu a ke dřevu na zemi (metry) a jak rychle jde sekat po sobě (sekundy).
  "reach": 1.7,
  "chopCooldownSeconds": 0.7,
  // Strom napřed crackSeconds praská a kymácí se, pak fallSeconds padá (čím dál rychleji). Pak dopadne: kdo je
  // v pruhu pádu, je zraněný.
  "crackSeconds": 2,
  "fallSeconds": 3.5,
  // Z koruny pokáceného stromu spadnou klacky (věci na zemi u koruny): perMeter na metr výšky stromu, nejmíň min,
  // nejvíc max, suchý strom deadMultiplier krát víc. Rozdělí se do piles hromádek.
  "crownSticks": { "perMeter": 0.6, "min": 5, "max": 15, "deadMultiplier": 1.5, "piles": 3 },
  // Pruh pádu: šířka (metry) a délka podle výšky stromu. Síla zranění hráče a zvířete (body života zvířete).
  "fallWidth": 1.4,
  "fallSeverity": 40,
  "fallAnimalDamage": 5,
  // Pařez: kolik metrů stromu zůstane stát. Ležící kmen je spodní část stromu (trunkShare výšky bez pařezu),
  // z každého celého metru je jeden klad. Zbytek je koruna (klacky, crownSticks).
  "stumpHeight": 0.6,
  "trunkShare": 0.6,
  // Ležící kmen blokuje cestu jako válec o tomto poloměru (metry). Klad na zemi neblokuje.
  "trunkRadius": 0.22,
  // Kolik třísek dá jeden díl dřeva.
  "splintersPerWood": 4,
  // S kladem v náruči jde postava pomaleji (násobek rychlosti).
  "carrySpeed": 0.6,
  // Díl dřeva v ohni hoří tolikrát déle než klacek.
  "woodBurnMultiplier": 3
}
