<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Zprávy mezi klientem a serverem a jednoduchý síťový klient (GameConnection).
    Používá ho server, testy i Unity. Nesmí odkazovat na Oohra.Core (tam jsou skrytá data).
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <EnableSourceLink>false</EnableSourceLink>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LiteNetLib" Version="2.1.4" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Oohra.Shared\Oohra.Shared.csproj" />
  </ItemGroup>

  <!-- Verze pro Unity se zkopíruje do Unity projektu, i s knihovnou LiteNetLib. -->
  <Target Name="CopyToUnity" AfterTargets="Build" Condition="'$(TargetFramework)' == 'netstandard2.1' And Exists('$(MSBuildProjectDirectory)\..\..\unity\Assets')">
    <Copy SourceFiles="$(TargetPath);$(PkgLiteNetLib)\lib\netstandard2.1\LiteNetLib.dll" DestinationFolder="$(MSBuildProjectDirectory)\..\..\unity\Assets\Plugins\Oohra" SkipUnchangedFiles="true" />
  </Target>

</Project>
